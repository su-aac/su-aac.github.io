---
import Layout from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { Footer } from '@components/odyssey-theme';
import settings from '../config/settings';
import { footerListsEn, footerSocials } from '../config/footer';

const seo = {
	title: 'Research Recruitment | Shared Reading Study for Children Who Cannot Rely on Speech in Taiwan',
	description: 'Inviting parents of children ages 3–7 who cannot rely on speech to be heard and understood to participate in an online survey about family shared reading resources and experiences.',
};
---

<Layout seo={seo}>
  <div class="full-page-split__wrapper">
    <section class="full-page-split__image-section">
      <div class="full-page-split__logo">
        <a href="/">
          <Logo />
        </a>
      </div>
      <picture>
        <img
          src="/assets/images/home/research_recruitment.png"
          alt="Research recruitment poster"
          class="full-page-split__image"
        />
      </picture>
    </section>
    <section class="full-page-split__content-section">
      <div class="full-page-split__content-container">
        <h1>Research Recruitment</h1>
        <p class="closed-notice"><strong>This survey is now closed.</strong> Thank you to every family who took part and to everyone who shared the invitation! This study is part of my dissertation, and I am now analyzing the data. I look forward to sharing the results with everyone soon.</p>

        <p>Hello! I'm Hsiao-Ting, currently a doctoral student in Speech-Language Pathology at the University of North Carolina at Chapel Hill (UNC-Chapel Hill). My dissertation research aims to understand <strong>the shared reading resources and experiences of families of children ages 3–7 in Taiwan who cannot rely on speech to be heard and understood</strong>.</p>

        <h2>Who Participated?</h2>
        <p>Parents or primary caregivers of children ages 3–7 who cannot rely on speech to be heard and understood.</p>
        <p>This includes children who typically say fewer than 100 words independently, as well as children who do not use spoken words.</p>
        <ul>
          <li>Families were welcome whether or not they were currently reading with their child (every family's experience matters)</li>
        </ul>

        <h2>How?</h2>
        <p>An anonymous online survey that took about 15–20 minutes to complete.</p>

        <h2>Incentive Drawing</h2>
        <p>All participants who completed the survey were entered into a drawing: <strong>10 winners / each receives a 7-Eleven e-gift card worth NT$300</strong>.</p>
      </div>
    </section>
  </div>
  <div class="full-width-cta">
    <div class="cta-section">
      <a href="/blog/posts/invite_research" class="cta-button">
        Read the Study Update
      </a>
    </div>
    <p class="closing-message">Stay tuned for a future post on the results!<br/>If you have any questions about the study, you are always welcome to contact me directly. Thank you for your support!</p>
  </div>
  <Footer
    slot="footer"
    background="var(--theme-surface-1)"
    color="var(--theme-on-surface-1)"
    footerLists={footerListsEn}
    footerSocials={footerSocials}
    copyrightName={settings.name}
    showPlug={settings.showPlug}
  >
    <Logo slot="logo" />
  </Footer>
</Layout>

<style>
.full-page-split__wrapper {
  display: grid;
  grid-template-columns: 4fr 6fr;
  grid-auto-columns: 1fr;
  min-height: 100vh;
}
.full-page-split__image-section {
  position: relative;
}
.full-page-split__image-section :global(img) {
  width: 100%;
  height: 100vh;
  object-fit: contain;
  background-color: #f5f5f5;
}
.full-page-split__logo {
  background-color: var(--theme-surface-1);
  color: (--theme-on-surface-1);
  padding: 0.5rem 1rem;
  border-radius: var(--theme-shape-radius);
  top: 1rem;
  left: 1rem;
  position: absolute;
  z-index: 1;
}
.full-page-split__logo a {
  text-decoration: none;
}
.full-page-split__content-section {
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow-y: auto;
}
.full-page-split__content-container {
  margin: 1rem;
  padding: 2rem;
}
.full-page-split__content-container h1 {
  font-size: var(--font-size-xl);
  margin-bottom: 1rem;
}
.full-page-split__content-container h2 {
  font-size: var(--font-size-lg);
  margin-top: 1.5rem;
  margin-bottom: 0.5rem;
  color: var(--theme-primary);
}
.full-page-split__content-container ul {
  margin-left: 1.5rem;
  margin-bottom: 1rem;
}
.full-page-split__content-container li {
  margin-bottom: 0.25rem;
}
.cta-section {
  margin: 2rem 0;
  text-align: center;
}
.cta-button {
  display: inline-block;
  background-color: var(--theme-primary);
  color: white;
  padding: 1rem 2rem;
  border-radius: var(--theme-shape-radius);
  text-decoration: none;
  font-size: var(--font-size-md);
  font-weight: bold;
  transition: background-color 0.3s ease;
}
.cta-button:hover {
  background-color: var(--theme-primary-hover, var(--theme-primary));
  opacity: 0.9;
}
.full-width-cta {
  width: 100%;
  padding: 2rem;
  text-align: center;
  margin-top: -4rem;
}
.closed-notice {
  background-color: var(--theme-surface-1);
  border-left: 4px solid var(--theme-primary);
  border-radius: var(--theme-shape-radius);
  padding: 1rem 1.25rem;
}
.closing-message {
  text-align: center;
  margin-top: 1.5rem;
  font-style: italic;
}
@media(max-width: 768px) {
  .full-page-split__wrapper {
    grid-template-columns: 1fr;
    grid-template-rows: 30vh auto;
  }
  .full-page-split__image-section :global(img) {
    max-height: 30vh;
    object-fit: contain;
  }
}
</style>
